SERVER_PORT=8080
# Preferred datasource contract. Supabase requires sslmode=require.
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Legacy component variables remain supported when DB_URL is not supplied.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=waypoint
RABBITMQ_PASSWORD=
ORDER_SERVICE_GRPC_HOST=order-service
ORDER_SERVICE_GRPC_PORT=9090
# Planning master-data adapter: jdbc until Order Service implements the extended gRPC contract
PLANNING_MASTER_DATA_MODE=jdbc
PLANNING_GRPC_PORT=9090
ORDER_SERVICE_GRPC_HOST=order-service
ORDER_SERVICE_GRPC_PORT=9090
