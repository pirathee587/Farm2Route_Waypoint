# ═══════════════════════════════════════════════════════════════════════════
#  Waypoint — Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# Supabase Shared Pooler Connection
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
SUPABASE_DB_HOST=<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=<your-database-password>

# ── JWT ─────────────────────────────────────────────────────────────────────
# Use the JWT Secret from: Supabase Dashboard → Project Settings → API → JWT Secret
JWT_SECRET=your-supabase-jwt-secret-here
JWT_EXPIRY_HOURS=8

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=waypoint
RABBITMQ_PASSWORD=changeme_rabbitmq_password
# Management UI: http://localhost:15672

# ── Service Internal URLs (used by API Gateway) ───────────────────────────
AUTH_SERVICE_URL=http://auth-service:8080
ORDER_SERVICE_URL=http://order-service:8080
PLANNING_SERVICE_URL=http://planning-service:8080
LOADING_DELIVERY_SERVICE_URL=http://loading-delivery-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080

# ── Frontend (Vite) ───────────────────────────────────────────────────────
VITE_API_BASE_URL=https://localhost/api
VITE_WS_URL=wss://localhost/api/notify/ws
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
