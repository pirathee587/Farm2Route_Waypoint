# Copy to .env and use the values shown by Supabase Dashboard > Connect.
# Session pooler (port 5432) is recommended for local Docker on IPv4 networks.
# Never commit .env.
SUPABASE_DB_HOST=your-session-pooler-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-supabase-database-password

RABBITMQ_USER=waypoint
RABBITMQ_PASSWORD=change_this_rabbitmq_password
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_ISSUER=waypoint-auth
JWT_AUDIENCE=waypoint-clients

# Browser-facing port and optional map integration
FRONTEND_PORT=3000
VITE_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Supabase API and Storage integration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_MODE=supabase

# Optional Docker Hub naming (images remain local until explicitly pushed)
DOCKERHUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest
RABBITMQ_MANAGEMENT_PORT=15672
