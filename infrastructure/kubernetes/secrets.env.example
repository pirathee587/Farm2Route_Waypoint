# Reference only. Do not load the same database identity into every service.
# Create <service>-secrets per the inventory; no Secret values are checked in.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
JWT_SECRET=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# URI-encode credentials; RabbitMQ vhost is waypoint.
RABBITMQ_URL=amqp://USER:PASSWORD@rabbitmq:5672/waypoint
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MAPBOX_ACCESS_TOKEN=
